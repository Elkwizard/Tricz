int multiply(int a, int b) {
    int result = 0;
    for (int i = 0; i < b; i++)
        result += a;
    return result;
}

// int factorial(int n) {
//     return n <= 1 ? 1 : multiply(n, factorial(n - 1));
// }

int factorial(int n) {
    int result = 1;
    for (int i = 2; i <= n; i++)
        result = multiply(result, i);
    return result;
}

int read() {
    return @(-2 as &int);
}

void print(int x) {
    @(-1 as &int) += x;
}

int square(int x) {
    return multiply(x, x);
}

int plus2(int px) {
    print(px - 2);
    print(px + 3);
    return px + 2;
}

int identity(int x) {
    print(x);
    return x;
}

void main() {
    print(multiply(read(), read()));
    print(factorial(read()));

    int(int)[] fns = [square, factorial];

    print((@((&fns as int + read()) as &(int(int))))(5));
}