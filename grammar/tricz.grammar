whitespace = hidden /\s+/
comment = hidden /(\/\/.*)|\/\*([\w\W]*?)\*\//
symbol = literals /\W+/
fixed = /\d+\.\d+/ 
int = /\d+/
string = /"(\\?.)*?"/
identifier = /[\w\d_]+/

@begin Type
	@begin Reference
		TypeReference = name:identifier
	@end

	IntType = name:"int"
	FixedType = name:"fixed"
	BoolType = name:"bool"
	VoidType = name:"void"
	LiteralType = IntType | FixedType | BoolType | VoidType
	NestedType = "(" replace:Type ")"
	PointerType = "&" target:Type

	BaseType = NestedType | PointerType | LiteralType | TypeReference

	FunctionTypeSuffix = "(" params:Type[","] ")"
	ArrayTypeSuffix = "[" length:Expression? "]"

	// for lowering
	FunctionType = result:Type params:Type*
	ArrayType = element:Type length:Expression?

	TypeStep = FunctionTypeSuffix | ArrayTypeSuffix
	TypeTerm = base:TypeTerm step:TypeStep | BaseType

	Type = TypeTerm
@end

@begin Expression
	@begin Reference
		Reference = name:identifier
	@end

	Int = value:int
	Fixed = value:fixed
	Bool = value:("true" | "false")
	Literal = Int | Fixed | Bool

	Nested = "(" replace:Expression ")"
    Array = "[" elements:Expression[","] "]"
	BaseExpression = Nested | Literal | Array | Sign | Reference

	CallSuffix = "(" args:Expression[","] ")"
	SubscriptSuffix = "[" index:Expression "]"
    IndirectSubscriptSuffix = "{" index:Expression "}"
	Step = CallSuffix | SubscriptSuffix | IndirectSubscriptSuffix

	// for lowering
	Call = fn:Expression args:Expression*
	Subscript = arr:Expression index:Expression
    IndirectSubscript = arr:Expression index:Expression
    
    @begin Unary
        Unary = target:Expression
        Negate = $Unary
        AddressOf = $Unary
        Dereference = $Unary
        Not = $Unary
    @end

	Term = base:Term step:Step | BaseExpression

	Expression = operators Term {
		prefix Prefix ("-" | "@" | "&" | "!" | "++" | "--")
		custom Cast (target:last "as" type:Type)
		suffix Increment ("++" | "--")
		left Product ("*" | "/" | "%")
		left Sum ("+" | "-")
		left Compare ("<=" | ">=" | "<" | ">" | "==" | "!=")
		left Logic ("&&" | "||")
		custom Ternary (condition:last "?" ifTrue:Expression ":" ifFalse:Ternary)
		right Assign ("=" | "+=" | "-=" | "/=" | "*=" | "%=" | "&&=" | "||=")
	}
@end

Continuing = "continuing" body:Statement

@begin Statement
    Label = (name:identifier ":")?
    If = "if" "(" condition:Expression ")" (ifTrue:Block "else" ifFalse:Block | ifTrue:Statement)
    @begin Declaration
        While = $Label "while" "(" condition:Expression ")" body:Statement continuing:Continuing?
        For = $Label "for" "(" (init:Variable | ExpressionStatement | ";") condition:Expression? ";" next:Expression ")" body:Statement
    @end
	Return = "return" value:Expression? ";"

    @begin Reference
        Break = "break" name:identifier? ";"
        Continue = "continue" name:identifier? ";"
    @end

	Control = If | For | While | Return | Break | Continue
	ExpressionStatement = value:Expression ";"
	@begin Scope
		Block = "{" stmts:(Statement | Variable)* "}"
	@end

	Statement = Block | Control | ExpressionStatement
@end

@begin Declaration
	Param = type:Type name:identifier
	Variable = $Param ("=" value:Expression)? ";"
	@begin Scope
		Function = result:Type name:identifier "(" params:Param[","] ")" body:Block
	@end

	Declaration = Function | Variable
@end

Program = decls:Declaration

Include = "include" path:string ";"

@begin Scope
	root = includes:Include* decls:Declaration*
@end