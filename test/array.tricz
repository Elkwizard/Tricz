include "stdlib";

int index(&int arr, int y) {
    return @((arr as int + y) as &int);
}

void main() {
    int[] x = [1, 2, 3];
    int[][] y = [[4, 5, 6], x];
    &int z = &y;
    &(int[3]) w = &x;

    print(read() + 4);

    print(&w{read()});

    // print(y[0][0]);
