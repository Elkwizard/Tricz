void output(int value) {
	(@(-1 as &int[1]))[0] += value;
    // (-1 as &int)[0] += value;
    @(-1 as &int) += value;
}

int min(int x, int y) {
    return x < y ? x : y;
}

int[3] several() {
    return [1, 2, 5];
}

void map(&int[0] arr, int length, int (int) fn) {
    for (int i = 0; i < length; i++) {
        (@arr)[i] = fn((@arr)[i]);
    }
}

int square(int x) {
